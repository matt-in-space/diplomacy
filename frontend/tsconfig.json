{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "../web/static/js",
    "rootDir": "src",
    "strict": true,
    "noEmitOnError": true,
    "sourceMap": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts"]
}
